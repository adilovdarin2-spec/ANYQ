{
  "name": "anyq",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:generate": "npm run generate --workspace=packages/db",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:pos": "npm run dev --workspace=apps/pos",
    "dev:orders": "npm run dev --workspace=apps/orders",
    "dev:api": "npm run dev --workspace=apps/api",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "backup": "node scripts/backup.mjs create",
    "backup:list": "node scripts/backup.mjs list",
    "backup:verify": "node scripts/backup.mjs verify",
    "maintenance": "node scripts/maintenance.mjs",
    "maintenance:loop": "node scripts/maintenance.mjs --loop",
    "smoke": "node scripts/smoke.mjs",
    "onboard:check": "node scripts/onboard-check.mjs",
    "build:deploy": "npm run build --workspace=apps/admin && npm run build --workspace=apps/pos && npm run build --workspace=apps/orders && node scripts/check-bundle.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "railway": "^3.6.0",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true
  }
}
