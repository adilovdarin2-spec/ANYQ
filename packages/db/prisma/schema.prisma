datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Fields that would naturally be enums (LocationType, UserRole, SupportLevel,
// DocumentType, DocumentStatus, CounterpartyType, SubstanceMovementType) are
// kept as plain strings validated in the API layer, and Tariff.modules stays
// a JSON-encoded string[] — this schema started on SQLite (no native enum/array
// support) and the string-based shape carried over unchanged to Postgres.

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  /// Confirmed second factor. Null until somebody has proved with a working
  /// code that the secret really reached their phone.
  totpSecret        String?
  /// A setup started and not yet confirmed. Kept apart so an owner who scans
  /// a QR and closes the tab has not locked themselves out.
  pendingTotpSecret String?
  totpEnabledAt     DateTime?

  recoveryCodes AdminRecoveryCode[]

  @@map("admin_users")
}

/// For the day the phone is lost. Hashed, because a recovery code is a
/// password with a longer name.
model AdminRecoveryCode {
  id          String    @id @default(cuid())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  adminUserId String
  codeHash    String
  /// Set the moment it is spent: a code that works twice is a password that
  /// survived being written on paper.
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@map("admin_recovery_codes")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  phone     String
  // Friendly, unique URL segment for the public /supply storefront —
  // e.g. anyq-orders.up.railway.app/dastarkhan-opt instead of a raw cuid.
  // Nullable: only companies with the supply module actually need one.
  slug      String?  @unique
  createdAt DateTime @default(now())

  tariff            Tariff?
  locations         Location[]
  users             User[]
  products          Product[]
  documents         Document[]
  counterparties    Counterparty[]
  shifts            Shift[]
  tables            Table[]
  pushSubscriptions PushSubscription[]
  idempotencyKeys   IdempotencyKey[]
  settlements       Settlement[]
  auditEntries      AuditEntry[]

  @@map("companies")
}

// Makes every mutating POS request safely retryable. A cashier's offline queue
// can't tell "the server never got this sale" from "the server saved it and
// the reply was lost coming back" — without a key the retry sells the same
// goods twice. The row is written inside the same transaction as the work it
// guards, so a committed key and a committed sale are one event: a retry finds
// both (and replays the stored response) or neither (and does the work).
//
// `response` holds the exact JSON body the first attempt returned — a retry
// has to reproduce it, not just avoid re-running. Rows are never read after
// their client stops retrying, so they want a retention job (drop keys older
// than a few days) once the table starts growing.
model IdempotencyKey {
  id          String   @id @default(cuid())
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String
  key         String
  endpoint    String
  requestHash String
  statusCode  Int
  response    String
  createdAt   DateTime @default(now())

  @@unique([companyId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model Tariff {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id])
  companyId         String   @unique
  modules           String
  locationLimit     Int?
  userLimit         Int?
  skuLimit          Int?
  docsPerMonthLimit Int?
  supportLevel      String   @default("basic")
  validUntil        DateTime
  blocked           Boolean  @default(false)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("tariffs")
}

model Location {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id])
  companyId String
  name      String
  type      String
  address   String?

  stocks           Stock[]
  batches          ProductBatch[]
  documents        Document[] @relation("SourceLocation")
  transfersIn      Document[] @relation("DestinationLocation")
  prescriptions    Prescription[]
  shifts           Shift[]
  tables           Table[]
  stockMovements   StockMovement[]
  stockPolicies    StockPolicy[]
  fiscalDevice     FiscalDevice?
  storageBins      StorageBin[]
  settlements      Settlement[]

  @@map("locations")
}

// Restaurant Pack: floor plan + KDS. A table's occupied/free state is derived
// from whether it has an open (status='open') sale Document, not tracked as a
// separate field — status here just mirrors that for cheap list queries.
model Table {
  id         String   @id @default(cuid())
  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String
  location   Location @relation(fields: [locationId], references: [id])
  locationId String
  name       String
  seats      Int      @default(2)
  status     String   @default("free")
  createdAt  DateTime @default(now())

  documents Document[]

  @@map("tables")
}

model User {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  name      String
  role      String
  phone     String?
  email     String?
  posPin    String?
  // Bumped whenever this person's access changes — a new PIN, a new role, or
  // an outright revocation. Tokens carry the version they were minted at, so
  // raising it retires every token already in the wild.
  //
  // A POS token lasts thirty days, which without this means a cashier who
  // leaves keeps selling for a month: changing their PIN stops them logging
  // in again and does nothing to the token already on their phone.
  tokenVersion Int   @default(0)
  createdAt DateTime @default(now())

  pushSubscriptions PushSubscription[]

  @@map("users")
}

// One row per subscribed browser/device. A POS user can enable notifications
// on more than one device; each gets its own row and its own endpoint.
model PushSubscription {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

model Shift {
  id                 String    @id @default(cuid())
  company            Company   @relation(fields: [companyId], references: [id])
  companyId          String
  location           Location  @relation(fields: [locationId], references: [id])
  locationId         String
  cashierName        String
  // Nullable so pre-existing shifts (created before this field existed) don't
  // need backfilling — their sales still get attributed by location+time only.
  // New shifts always set this, letting the admin shift report correlate each
  // shift with exactly its own cashier's sales instead of everyone's sales at
  // that location, which matters as soon as two registers are open at once.
  userId             String?
  openedAt           DateTime
  openingCash        Int
  closedAt           DateTime?
  closingCashCounted Int?
  // The id the register generated when the shift was opened, which is stable
  // from that moment whether or not there was a network. `id` is the server's
  // key and does not exist until the shift reaches it, so a sale rung offline
  // has nothing else to point at.
  //
  // Unique per company, which is also what makes opening a shift safe to
  // retry: a second attempt finds the first rather than opening a second
  // shift with its own opening float.
  clientCommandId    String?
  createdAt          DateTime  @default(now())

  documents          Document[]

  @@unique([companyId, clientCommandId])
  @@map("shifts")
}

model Product {
  id              String  @id @default(cuid())
  company         Company @relation(fields: [companyId], references: [id])
  companyId       String
  name            String
  category        String?
  unit            String
  barcode         String?
  ntinCode        String?
  purchasePrice   Int
  salePrice       Int
  taxMode         String?
  stopListed      Boolean @default(false)
  sellable        Boolean @default(true)
  saleUnit        String  @default("piece")
  parentProduct   Product?  @relation("ProductVariants", fields: [parentProductId], references: [id])
  parentProductId String?
  variantLabel    String?
  variants        Product[] @relation("ProductVariants")

  stocks         Stock[]
  batches        ProductBatch[]
  documentItems  DocumentItem[]
  prescriptions  Prescription[]
  ledgerEntries  ControlledSubstanceLedger[]
  recipe         Recipe?             @relation("DishRecipe")
  usedInRecipes  RecipeIngredient[]  @relation("IngredientUsage")
  modifiers      ProductModifier[]
  stockMovements StockMovement[]
  packagings     ProductPackaging[]
  stockPolicies  StockPolicy[]

  @@map("products")
}

// The registered cash register a point sells through. One per location,
// because a ККМ is registered to a place, not to a company.
//
// No credentials here. A provider's API key is a secret shared with the tax
// authority's operator, and storing one per company in plain columns is a
// decision that needs encryption at rest and a key custodian — not a default
// chosen in passing. Until that exists, the credential lives in the
// deployment's environment and this row only says which provider and which
// registration number.
model FiscalDevice {
  id                 String   @id @default(cuid())
  location           Location @relation(fields: [locationId], references: [id])
  locationId         String   @unique
  // 'none' — not fiscalised here. 'manual' — a standalone register next to the
  // POS, whose number a cashier enters. Network providers are added as
  // adapters against the same interface.
  provider           String   @default("none")
  /// РНМ: the number the register is entered in the state register under.
  registrationNumber String
  enabled            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("fiscal_devices")
}

// A printed POS slip is not a fiscal receipt. It becomes one only when a
// registered cash register or its operator confirms it, and a shop has to be
// able to answer "which of today's sales never reached the tax authority" —
// which it can only do if the two were never treated as the same thing.
//
// One row per sale, so a retry registers the same receipt rather than a
// second one: the tax version of selling the same goods twice.
model FiscalReceipt {
  id           String    @id @default(cuid())
  document     Document  @relation(fields: [documentId], references: [id])
  documentId   String    @unique
  provider     String
  status       String    @default("pending")
  attempts     Int       @default(0)
  lastError    String?
  fiscalNumber String?
  fiscalSign   String?
  registeredAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("fiscal_receipts")
}

// A place inside a building that goods can be sent to or found in:
// zone → rack → shelf → bin. `code` is the label painted on the shelf, and it
// is what Stock and StockMovement carry — not an id, because the address is
// the thing people read out to each other, and because renaming a shelf is a
// deliberate act rather than a silent cascade.
//
// The empty code is reserved and never stored here: it means "arrived and not
// put away yet", which is a real state a warehouse needs to see rather than an
// absence to be hidden.
model StorageBin {
  id         String   @id @default(cuid())
  location   Location @relation(fields: [locationId], references: [id])
  locationId String
  code       String
  zone       String
  rack       String   @default("")
  shelf      String   @default("")
  bin        String   @default("")
  createdAt  DateTime @default(now())

  @@unique([locationId, code])
  @@index([locationId, zone])
  @@map("storage_bins")
}

// How much of a product a particular point wants to keep. Per location, not
// per product: a warehouse holding a month of cover and the shop it feeds
// holding three days are the same goods with completely different answers, and
// one company-wide number would be wrong for both.
//
// Every field is optional in effect — zero means "no opinion, work it out from
// demand". An owner who does have an opinion outranks the estimate, because on
// slow-moving goods they know something the sales history cannot show.
model StockPolicy {
  id             String   @id @default(cuid())
  product        Product  @relation(fields: [productId], references: [id])
  productId      String
  location       Location @relation(fields: [locationId], references: [id])
  locationId     String
  minQuantity    Float    @default(0)
  targetQuantity Float    @default(0)
  // How long this point waits between ordering and receiving. The single
  // number that decides whether a shelf is empty when the van arrives.
  leadTimeDays   Int      @default(3)
  updatedAt      DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([locationId])
  @@map("stock_policies")
}

// The same goods arrive in one shape and leave in another: water comes in by
// the case of 24 and leaves the shelf a bottle at a time. Stock, movements and
// every quantity in the ledger stay in the product's base unit — a packaging is
// only a multiplier that documents and scanners work in, never a second place
// stock is counted.
//
// Getting this wrong is how a receipt of 2 cases becomes 2 bottles on the
// shelf, which is the single most common way a hardware or wholesale
// business's stock stops matching reality.
model ProductPackaging {
  id           String  @id @default(cuid())
  product      Product @relation(fields: [productId], references: [id])
  productId    String
  name         String
  // How many base units this holds. Float for the same reason Stock.quantity
  // is: a "packaging" can be a 0.5 kg pack of something sold by weight.
  unitsPerPack Float
  // Cases carry their own barcode, distinct from the unit's. Scanning it at
  // receiving is the whole point: one scan, and the quantity is already right.
  barcode      String?
  createdAt    DateTime @default(now())

  documentItems DocumentItem[]

  @@unique([productId, name])
  @@index([barcode])
  @@map("product_packagings")
}

// A dish (sellable Product) has at most one Recipe — its bill of materials.
// Ingredient quantities are plain Int, same as every other quantity field in
// this schema (see note above) — recipes should use fine-grained ingredient
// units (grams, ml) rather than coarse ones (kg, l) so whole numbers stay
// meaningful, instead of introducing fractional quantities schema-wide.
model Recipe {
  id           String  @id @default(cuid())
  product      Product @relation("DishRecipe", fields: [productId], references: [id])
  productId    String  @unique
  portionYield Int     @default(1)

  ingredients RecipeIngredient[]

  @@map("recipes")
}

/// How a sale was paid for, one row per method.
///
/// A single method is not a special case here — it is a split of one. Storing
/// both shapes the same way is what lets the drawer reconciliation, the reports
/// and the receipt each have one code path instead of two.
model SalePayment {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  method     String
  amount     Int
  createdAt  DateTime @default(now())

  @@unique([documentId, method])
  @@index([documentId])
  @@map("sale_payments")
}

/// Who changed what, and to what.
///
/// Goods have carried an author and a reason since the ledger existed; prices,
/// roles and credit limits did not. Those are the changes that move money
/// without moving anything off a shelf.
model AuditEntry {
  id         String  @id @default(cuid())
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  /// 'product' | 'user' | 'counterparty'
  entity     String
  entityId   String
  /// Copied in at the time of the change, so the log still reads after a
  /// rename or a deletion — which is exactly when it is being read.
  entityName String
  field      String
  /// Null on both sides for a secret: only that it moved is recorded.
  before     String?
  after      String?
  actorId    String?
  actorName  String
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("audit_entries")
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  recipe       Recipe  @relation(fields: [recipeId], references: [id])
  recipeId     String
  ingredient   Product @relation("IngredientUsage", fields: [ingredientId], references: [id])
  ingredientId String
  quantity     Int

  @@map("recipe_ingredients")
}

model ProductModifier {
  id         String  @id @default(cuid())
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  name       String
  priceDelta Int

  @@map("product_modifiers")
}

model Stock {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  location    Location @relation(fields: [locationId], references: [id])
  locationId  String
  // Float, not Int — the one place this schema departs from its own
  // whole-numbers convention (see note above Recipe), specifically so
  // weight-based sale (kg) works: price * quantity keeps computing the
  // right revenue everywhere with zero call-site changes, since JS/TS
  // numbers don't distinguish int from float. DocumentItem.quantity is
  // widened the same way for the same reason; RecipeIngredient and
  // ProductBatch stay Int since they're untouched by retail weight-sale.
  quantity    Float
  // Promised to somebody else and not yet handed over — the open orders
  // standing against this row. Available to sell is quantity - reserved, and
  // that is the figure a register may draw on; `quantity` alone would let a
  // walk-in buy goods an online customer has already been told are theirs.
  //
  // A cache over pending order documents, the same way quantity is a cache
  // over the movement ledger: only ever changed inside the transaction that
  // changes the order, and rebuildable from those orders. It writes no
  // movement row, because nothing physically moved — the order explains it.
  reserved    Float   @default(0)
  // Physically here, on the books, and not for sale: quarantined pending a
  // decision. Pretending blocked goods are gone understates stock; leaving
  // them sellable sells them. Available is quantity - reserved - blocked.
  blocked     Float   @default(0)
  // Not nullable, and '' means "not put away in a bin yet". In Postgres two
  // NULLs are never equal, so a nullable column left the @@unique below
  // enforcing nothing for the rows the app actually writes — two concurrent
  // first receipts of one product could each create a row, and the read path
  // (a Map keyed by productId) would keep one and lose the other's quantity.
  binLocation String  @default("")

  @@unique([productId, locationId, binLocation])
  // Reading a whole location's stock is the commonest query in the product:
  // the sale grid, every availability check, the bin map and the order list.
  @@index([locationId])
  @@map("stocks")
}

model ProductBatch {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  location    Location @relation(fields: [locationId], references: [id])
  locationId  String
  batchNumber String
  expiryDate  DateTime
  quantity    Int
  createdAt   DateTime @default(now())

  documentItems DocumentItem[]
  ledgerEntries ControlledSubstanceLedger[]

  @@index([productId, locationId])
  @@map("product_batches")
}

model Document {
  id            String        @id @default(cuid())
  company       Company       @relation(fields: [companyId], references: [id])
  companyId     String
  location      Location      @relation("SourceLocation", fields: [locationId], references: [id])
  locationId    String
  toLocation    Location?     @relation("DestinationLocation", fields: [toLocationId], references: [id])
  toLocationId  String?
  type          String
  status        String        @default("draft")
  /// The single method when there was one, 'mixed' when the sale was split.
  /// Kept alongside `payments` so everything written before splits existed
  /// still means what it meant.
  paymentMethod String?
  payments      SalePayment[]
  discountType  String?
  discountValue Int?
  pointsEarned  Int?
  pointsRedeemed Int?
  counterparty  Counterparty? @relation(fields: [counterpartyId], references: [id])
  counterpartyId String?
  table         Table?        @relation(fields: [tableId], references: [id])
  tableId       String?
  // The shift this was rung on. Kept on the document rather than worked out
  // from time ranges, because a time range is wrong in the two cases that
  // matter most: two registers open at once, and an offline device uploading
  // its sales hours later — those arrive stamped with the moment they synced,
  // which is a different shift or none at all.
  shift         Shift?        @relation(fields: [shiftId], references: [id])
  shiftId       String?
  // Only set for type='order' placed through the public /supply storefront —
  // where the customer wants this delivered, in their own words.
  deliveryAddress String?
  // Why this document exists, in the words of whoever made it. Required for a
  // return: a refund with no stated reason is the cheapest way to take money
  // out of a till, and "a reason and the right to do it" is what makes one
  // accountable rather than merely recorded.
  reason        String?
  // The countable half of that, on a write-off: 'damage', 'expiry', 'theft',
  // 'quality', 'other'. Free text alone can't answer "do we lose more to
  // breakage or to expiry"; a code can, and the note explains the instance.
  reasonCode    String?
  // When the goods are promised, on a purchase order. The date a lead time is
  // measured against, and the one that makes "late" answerable.
  expectedAt    DateTime?
  // The sale a return is against. A return standing on its own would let a
  // cashier refund goods nobody ever bought — the oldest way a till is
  // emptied — so a return is always a claim on one specific receipt, and can
  // never give back more than that receipt sold.
  originalDocument   Document?  @relation("DocumentReturns", fields: [originalDocumentId], references: [id])
  originalDocumentId String?
  returns            Document[] @relation("DocumentReturns")
  // What was actually handed back, on a return. Not derivable from the lines:
  // a refund owes a share of the discount and the points the sale collected,
  // so it is almost never the sum of the returned lines at list price.
  refundAmount  Int?
  createdBy     String?
  createdAt     DateTime      @default(now())
  fulfilledBy   String?
  fulfilledAt   DateTime?

  items          DocumentItem[]
  stockMovements StockMovement[]
  fiscalReceipt  FiscalReceipt?
  settlements    Settlement[]

  @@index([companyId, type, createdAt])
  // Every debt figure starts from "what has this counterparty been charged".
  @@index([counterpartyId, type])
  // Cash reconciliation reads a shift's own takings.
  @@index([shiftId])
  @@map("documents")
}

// Source of truth for stock: every quantity change is a signed movement row
// here, and Stock.quantity is a materialized cache kept in lockstep with it
// (always updated together, inside the same transaction, via the shared
// applyStockDelta/createStockWithMovement helpers in stock.ts — nothing else
// is allowed to call prisma.stock.update/create directly). The cache exists
// purely for fast reads (product list stock, shortage checks); the ledger is
// what makes reconciliation and audit trail possible.
model StockMovement {
  id         String    @id @default(cuid())
  product    Product   @relation(fields: [productId], references: [id])
  productId  String
  location   Location  @relation(fields: [locationId], references: [id])
  locationId String
  quantity   Float
  reason     String
  document   Document? @relation(fields: [documentId], references: [id])
  documentId String?
  // Which bin the goods left or arrived in, so a discrepancy can be traced to
  // a shelf rather than to a building. '' means they were never put away.
  binLocation String  @default("")
  // Who moved it. A reason and a document say what happened; only this says
  // who did it, which is the question actually being asked when a shortage
  // turns up. Nullable for the rows written before it existed, and for the
  // storefront, where the mover is a customer with no user account.
  // A plain id, not a relation — same shape as Document.createdBy.
  createdBy  String?
  createdAt  DateTime  @default(now())

  @@index([productId, locationId])
  @@index([locationId, createdAt])
  @@map("stock_movements")
}

model DocumentItem {
  id            String        @id @default(cuid())
  document      Document      @relation(fields: [documentId], references: [id])
  documentId    String
  product       Product       @relation(fields: [productId], references: [id])
  productId     String
  batch         ProductBatch? @relation(fields: [batchId], references: [id])
  batchId       String?
  quantity      Float
  // The sale line this return line gives back. Keeps the cap per line rather
  // than per product, so a partly-returned receipt can still be reasoned
  // about, and so the goods go back into the batch they left from.
  // What the person actually handled, when it wasn't loose units: 2 cases
  // rather than 48 bottles. `quantity` above is always the base-unit figure
  // these three resolve to, so nothing downstream has to know about packs.
  //
  // packPrice is kept alongside the derived per-unit `price` because the two
  // can't both be exact in whole tenge — a 1000 ₸ case of 24 is 41.67 a
  // bottle. The pack price is what was really paid, so it is what a supplier
  // balance is built from; the per-unit price is the rounded figure margin
  // maths uses.
  packaging      ProductPackaging? @relation(fields: [packagingId], references: [id])
  packagingId    String?
  packQuantity   Float?
  packPrice      Int?
  originalItem   DocumentItem?  @relation("ItemReturns", fields: [originalItemId], references: [id])
  originalItemId String?
  returns        DocumentItem[] @relation("ItemReturns")
  // What actually arrived, against the `quantity` that was sent. Null until
  // the document is received. A transfer that leaves with 5 and arrives with
  // 4 is the shape a loss in transit takes, and it is only visible if both
  // numbers survive — overwriting quantity with what turned up would erase
  // the discrepancy at the moment it is discovered.
  receivedQuantity Float?
  /// What was found on the shelves, against the `quantity` ordered. Null until
  /// somebody walked the racks for this line; zero means they looked and it was
  /// not there, which is a finding rather than an absence.
  pickedQuantity   Float?
  price         Int
  // Restaurant Pack KDS status. Only meaningful for dine-in table orders
  // (type='sale', tableId set) — every other document type ignores it.
  kitchenStatus String        @default("pending")

  @@index([originalItemId])
  @@map("document_items")
}

model Counterparty {
  id            String  @id @default(cuid())
  company       Company @relation(fields: [companyId], references: [id])
  companyId     String
  name          String
  phone         String?
  type          String
  binIin        String?
  loyaltyPoints Int     @default(0)
  // Whether this account may take goods away without paying. The permission
  // itself: a cashier can let a regular the owner has set up buy on credit,
  // and cannot open an account for a phone number typed at the counter.
  creditAllowed Boolean @default(false)
  // 0 means "no ceiling set", not "no credit" — an owner who wants to stop
  // credit turns the account off rather than setting the number to nothing.
  creditLimit   Int     @default(0)

  documents   Document[]
  settlements Settlement[]

  @@index([companyId, type])
  @@map("counterparties")
}

// Money moving between the company and somebody it deals with. A sale on
// credit and a delivery not yet paid for are both debts, and a shop that only
// records what passed through the till can answer "what did we take today" but
// never "where is our money".
//
// Kept apart from Document deliberately: a payment settles documents, and one
// payment can settle several. Folding it into the same table would make
// "what does this invoice still owe" a question about document types.
model Settlement {
  id             String       @id @default(cuid())
  company        Company      @relation(fields: [companyId], references: [id])
  companyId      String
  location       Location     @relation(fields: [locationId], references: [id])
  locationId     String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id])
  counterpartyId String
  /// 'in' — money from a customer. 'out' — money to a supplier.
  direction      String
  amount         Int
  paymentMethod  String
  /// Which document this instalment went against. Null while it sits on account.
  document       Document?    @relation(fields: [documentId], references: [id])
  documentId     String?
  note           String?
  createdBy      String?
  createdAt      DateTime     @default(now())

  @@index([companyId, counterpartyId, createdAt])
  @@index([documentId])
  @@map("settlements")
}

model Prescription {
  id                 String   @id @default(cuid())
  location           Location @relation(fields: [locationId], references: [id])
  locationId         String
  product            Product  @relation(fields: [productId], references: [id])
  productId          String
  prescriptionNumber String
  issuedDate         DateTime
  retainUntil        DateTime
  createdAt          DateTime @default(now())

  @@map("prescriptions")
}

model ControlledSubstanceLedger {
  id           String       @id @default(cuid())
  product      Product      @relation(fields: [productId], references: [id])
  productId    String
  batch        ProductBatch @relation(fields: [batchId], references: [id])
  batchId      String
  movementType String
  quantity     Int
  documentRef  String?
  loggedBy     String
  loggedAt     DateTime     @default(now())

  @@map("controlled_substance_ledger")
}
