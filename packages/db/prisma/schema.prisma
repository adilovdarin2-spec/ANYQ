datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Fields that would naturally be enums (LocationType, UserRole, SupportLevel,
// DocumentType, DocumentStatus, CounterpartyType, SubstanceMovementType) are
// kept as plain strings validated in the API layer, and Tariff.modules stays
// a JSON-encoded string[] — this schema started on SQLite (no native enum/array
// support) and the string-based shape carried over unchanged to Postgres.

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  phone     String
  // Friendly, unique URL segment for the public /supply storefront —
  // e.g. anyq-orders.up.railway.app/dastarkhan-opt instead of a raw cuid.
  // Nullable: only companies with the supply module actually need one.
  slug      String?  @unique
  createdAt DateTime @default(now())

  tariff            Tariff?
  locations         Location[]
  users             User[]
  products          Product[]
  documents         Document[]
  counterparties    Counterparty[]
  shifts            Shift[]
  tables            Table[]
  pushSubscriptions PushSubscription[]
  idempotencyKeys   IdempotencyKey[]

  @@map("companies")
}

// Makes every mutating POS request safely retryable. A cashier's offline queue
// can't tell "the server never got this sale" from "the server saved it and
// the reply was lost coming back" — without a key the retry sells the same
// goods twice. The row is written inside the same transaction as the work it
// guards, so a committed key and a committed sale are one event: a retry finds
// both (and replays the stored response) or neither (and does the work).
//
// `response` holds the exact JSON body the first attempt returned — a retry
// has to reproduce it, not just avoid re-running. Rows are never read after
// their client stops retrying, so they want a retention job (drop keys older
// than a few days) once the table starts growing.
model IdempotencyKey {
  id          String   @id @default(cuid())
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String
  key         String
  endpoint    String
  requestHash String
  statusCode  Int
  response    String
  createdAt   DateTime @default(now())

  @@unique([companyId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model Tariff {
  id                String   @id @default(cuid())
  company           Company  @relation(fields: [companyId], references: [id])
  companyId         String   @unique
  modules           String
  locationLimit     Int?
  userLimit         Int?
  skuLimit          Int?
  docsPerMonthLimit Int?
  supportLevel      String   @default("basic")
  validUntil        DateTime
  blocked           Boolean  @default(false)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("tariffs")
}

model Location {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id])
  companyId String
  name      String
  type      String
  address   String?

  stocks           Stock[]
  batches          ProductBatch[]
  documents        Document[] @relation("SourceLocation")
  transfersIn      Document[] @relation("DestinationLocation")
  prescriptions    Prescription[]
  shifts           Shift[]
  tables           Table[]
  stockMovements   StockMovement[]

  @@map("locations")
}

// Restaurant Pack: floor plan + KDS. A table's occupied/free state is derived
// from whether it has an open (status='open') sale Document, not tracked as a
// separate field — status here just mirrors that for cheap list queries.
model Table {
  id         String   @id @default(cuid())
  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String
  location   Location @relation(fields: [locationId], references: [id])
  locationId String
  name       String
  seats      Int      @default(2)
  status     String   @default("free")
  createdAt  DateTime @default(now())

  documents Document[]

  @@map("tables")
}

model User {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  name      String
  role      String
  phone     String?
  email     String?
  posPin    String?
  createdAt DateTime @default(now())

  pushSubscriptions PushSubscription[]

  @@map("users")
}

// One row per subscribed browser/device. A POS user can enable notifications
// on more than one device; each gets its own row and its own endpoint.
model PushSubscription {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

model Shift {
  id                 String    @id @default(cuid())
  company            Company   @relation(fields: [companyId], references: [id])
  companyId          String
  location           Location  @relation(fields: [locationId], references: [id])
  locationId         String
  cashierName        String
  // Nullable so pre-existing shifts (created before this field existed) don't
  // need backfilling — their sales still get attributed by location+time only.
  // New shifts always set this, letting the admin shift report correlate each
  // shift with exactly its own cashier's sales instead of everyone's sales at
  // that location, which matters as soon as two registers are open at once.
  userId             String?
  openedAt           DateTime
  openingCash        Int
  closedAt           DateTime?
  closingCashCounted Int?
  createdAt          DateTime  @default(now())

  @@map("shifts")
}

model Product {
  id              String  @id @default(cuid())
  company         Company @relation(fields: [companyId], references: [id])
  companyId       String
  name            String
  category        String?
  unit            String
  barcode         String?
  ntinCode        String?
  purchasePrice   Int
  salePrice       Int
  taxMode         String?
  stopListed      Boolean @default(false)
  sellable        Boolean @default(true)
  saleUnit        String  @default("piece")
  parentProduct   Product?  @relation("ProductVariants", fields: [parentProductId], references: [id])
  parentProductId String?
  variantLabel    String?
  variants        Product[] @relation("ProductVariants")

  stocks         Stock[]
  batches        ProductBatch[]
  documentItems  DocumentItem[]
  prescriptions  Prescription[]
  ledgerEntries  ControlledSubstanceLedger[]
  recipe         Recipe?             @relation("DishRecipe")
  usedInRecipes  RecipeIngredient[]  @relation("IngredientUsage")
  modifiers      ProductModifier[]
  stockMovements StockMovement[]

  @@map("products")
}

// A dish (sellable Product) has at most one Recipe — its bill of materials.
// Ingredient quantities are plain Int, same as every other quantity field in
// this schema (see note above) — recipes should use fine-grained ingredient
// units (grams, ml) rather than coarse ones (kg, l) so whole numbers stay
// meaningful, instead of introducing fractional quantities schema-wide.
model Recipe {
  id           String  @id @default(cuid())
  product      Product @relation("DishRecipe", fields: [productId], references: [id])
  productId    String  @unique
  portionYield Int     @default(1)

  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  recipe       Recipe  @relation(fields: [recipeId], references: [id])
  recipeId     String
  ingredient   Product @relation("IngredientUsage", fields: [ingredientId], references: [id])
  ingredientId String
  quantity     Int

  @@map("recipe_ingredients")
}

model ProductModifier {
  id         String  @id @default(cuid())
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  name       String
  priceDelta Int

  @@map("product_modifiers")
}

model Stock {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  location    Location @relation(fields: [locationId], references: [id])
  locationId  String
  // Float, not Int — the one place this schema departs from its own
  // whole-numbers convention (see note above Recipe), specifically so
  // weight-based sale (kg) works: price * quantity keeps computing the
  // right revenue everywhere with zero call-site changes, since JS/TS
  // numbers don't distinguish int from float. DocumentItem.quantity is
  // widened the same way for the same reason; RecipeIngredient and
  // ProductBatch stay Int since they're untouched by retail weight-sale.
  quantity    Float
  // Promised to somebody else and not yet handed over — the open orders
  // standing against this row. Available to sell is quantity - reserved, and
  // that is the figure a register may draw on; `quantity` alone would let a
  // walk-in buy goods an online customer has already been told are theirs.
  //
  // A cache over pending order documents, the same way quantity is a cache
  // over the movement ledger: only ever changed inside the transaction that
  // changes the order, and rebuildable from those orders. It writes no
  // movement row, because nothing physically moved — the order explains it.
  reserved    Float   @default(0)
  // Not nullable, and '' means "not put away in a bin yet". In Postgres two
  // NULLs are never equal, so a nullable column left the @@unique below
  // enforcing nothing for the rows the app actually writes — two concurrent
  // first receipts of one product could each create a row, and the read path
  // (a Map keyed by productId) would keep one and lose the other's quantity.
  binLocation String  @default("")

  @@unique([productId, locationId, binLocation])
  @@map("stocks")
}

model ProductBatch {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  location    Location @relation(fields: [locationId], references: [id])
  locationId  String
  batchNumber String
  expiryDate  DateTime
  quantity    Int
  createdAt   DateTime @default(now())

  documentItems DocumentItem[]
  ledgerEntries ControlledSubstanceLedger[]

  @@index([productId, locationId])
  @@map("product_batches")
}

model Document {
  id            String        @id @default(cuid())
  company       Company       @relation(fields: [companyId], references: [id])
  companyId     String
  location      Location      @relation("SourceLocation", fields: [locationId], references: [id])
  locationId    String
  toLocation    Location?     @relation("DestinationLocation", fields: [toLocationId], references: [id])
  toLocationId  String?
  type          String
  status        String        @default("draft")
  paymentMethod String?
  discountType  String?
  discountValue Int?
  pointsEarned  Int?
  pointsRedeemed Int?
  counterparty  Counterparty? @relation(fields: [counterpartyId], references: [id])
  counterpartyId String?
  table         Table?        @relation(fields: [tableId], references: [id])
  tableId       String?
  // Only set for type='order' placed through the public /supply storefront —
  // where the customer wants this delivered, in their own words.
  deliveryAddress String?
  createdBy     String?
  createdAt     DateTime      @default(now())
  fulfilledBy   String?
  fulfilledAt   DateTime?

  items          DocumentItem[]
  stockMovements StockMovement[]

  @@map("documents")
}

// Source of truth for stock: every quantity change is a signed movement row
// here, and Stock.quantity is a materialized cache kept in lockstep with it
// (always updated together, inside the same transaction, via the shared
// applyStockDelta/createStockWithMovement helpers in stock.ts — nothing else
// is allowed to call prisma.stock.update/create directly). The cache exists
// purely for fast reads (product list stock, shortage checks); the ledger is
// what makes reconciliation and audit trail possible.
model StockMovement {
  id         String    @id @default(cuid())
  product    Product   @relation(fields: [productId], references: [id])
  productId  String
  location   Location  @relation(fields: [locationId], references: [id])
  locationId String
  quantity   Float
  reason     String
  document   Document? @relation(fields: [documentId], references: [id])
  documentId String?
  // Who moved it. A reason and a document say what happened; only this says
  // who did it, which is the question actually being asked when a shortage
  // turns up. Nullable for the rows written before it existed, and for the
  // storefront, where the mover is a customer with no user account.
  // A plain id, not a relation — same shape as Document.createdBy.
  createdBy  String?
  createdAt  DateTime  @default(now())

  @@index([productId, locationId])
  @@index([locationId, createdAt])
  @@map("stock_movements")
}

model DocumentItem {
  id            String        @id @default(cuid())
  document      Document      @relation(fields: [documentId], references: [id])
  documentId    String
  product       Product       @relation(fields: [productId], references: [id])
  productId     String
  batch         ProductBatch? @relation(fields: [batchId], references: [id])
  batchId       String?
  quantity      Float
  // What actually arrived, against the `quantity` that was sent. Null until
  // the document is received. A transfer that leaves with 5 and arrives with
  // 4 is the shape a loss in transit takes, and it is only visible if both
  // numbers survive — overwriting quantity with what turned up would erase
  // the discrepancy at the moment it is discovered.
  receivedQuantity Float?
  price         Int
  // Restaurant Pack KDS status. Only meaningful for dine-in table orders
  // (type='sale', tableId set) — every other document type ignores it.
  kitchenStatus String        @default("pending")

  @@map("document_items")
}

model Counterparty {
  id            String  @id @default(cuid())
  company       Company @relation(fields: [companyId], references: [id])
  companyId     String
  name          String
  phone         String?
  type          String
  binIin        String?
  loyaltyPoints Int     @default(0)

  documents Document[]

  @@map("counterparties")
}

model Prescription {
  id                 String   @id @default(cuid())
  location           Location @relation(fields: [locationId], references: [id])
  locationId         String
  product            Product  @relation(fields: [productId], references: [id])
  productId          String
  prescriptionNumber String
  issuedDate         DateTime
  retainUntil        DateTime
  createdAt          DateTime @default(now())

  @@map("prescriptions")
}

model ControlledSubstanceLedger {
  id           String       @id @default(cuid())
  product      Product      @relation(fields: [productId], references: [id])
  productId    String
  batch        ProductBatch @relation(fields: [batchId], references: [id])
  batchId      String
  movementType String
  quantity     Int
  documentRef  String?
  loggedBy     String
  loggedAt     DateTime     @default(now())

  @@map("controlled_substance_ledger")
}
