/**
 * Типы к общему разборщику исходников.
 *
 * Сам он написан на .mjs: его зовут и охраны на TypeScript, и скрипты сборки
 * на обычном node, — а без этого файла каждая охрана получала бы `any`, и
 * `.split('\n')` в ней переставал бы проверяться вовсе.
 */

export interface WithoutCommentsOptions {
  /**
   * Считать ли `//` началом комментария. Для CSS — нет: там это часть адреса
   * в `url(...)`, и съеденный остаток строки уронил бы охрану вёрстки на
   * исправном файле.
   */
  lineComments?: boolean;
}

/** Исходник без комментариев: строки и переводы строк сохраняются. */
export function withoutComments(source: string, options?: WithoutCommentsOptions): string;
